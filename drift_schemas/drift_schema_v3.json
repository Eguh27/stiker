  "fixed_sql": [
    {
      "name": "packs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"packs\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"author\" TEXT NOT NULL, \"tray_icon_path\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"is_synced\" INTEGER NOT NULL CHECK (\"is_synced\" IN (0, 1)), \"emojis\" TEXT NOT NULL DEFAULT '[]', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "stickers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stickers\" (\"id\" TEXT NOT NULL, \"file_path\" TEXT NOT NULL, \"thumb_path\" TEXT NOT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"size_kb\" INTEGER NOT NULL, \"sha256\" TEXT NOT NULL, \"source_type\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (source_type IN ('GALLERY_SHARE', 'GALLERY_PICKER', 'PINTEREST', 'GENERIC_URL', 'DIRECT_IMAGE_LINK', 'MANUAL_FILE')));"
        }
      ]
    },
    {
      "name": "pack_stickers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pack_stickers\" (\"pack_id\" TEXT NOT NULL REFERENCES packs (id), \"sticker_id\" TEXT NOT NULL REFERENCES stickers (id), \"position\" INTEGER NOT NULL, PRIMARY KEY (\"pack_id\", \"sticker_id\"));"
        }
      ]
    },
    {
      "name": "import_queue",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_queue\" (\"id\" TEXT NOT NULL, \"source_url\" TEXT NULL, \"local_input_path\" TEXT NULL, \"source_type\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"progress\" INTEGER NOT NULL, \"error_message\" TEXT NULL, \"auto_rmbg\" INTEGER NOT NULL CHECK (\"auto_rmbg\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (source_type IN ('GALLERY_SHARE', 'GALLERY_PICKER', 'PINTEREST', 'GENERIC_URL', 'DIRECT_IMAGE_LINK', 'MANUAL_FILE')), CHECK (status IN ('PENDING', 'DOWNLOADING', 'PROCESSING', 'FAILED', 'DONE')));"
        }
      ]
    },
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"sticker_id\" TEXT NOT NULL REFERENCES stickers (id), \"project_json\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
