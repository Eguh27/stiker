+import 'package:sticker_studio/features/queue/data/app_database_provider.dart';
+
+import 'sticker_providers.dart';
+
+/// Memasukkan tautan ke antrean; proses jalan di latar belakang dengan
+/// progres di notifikasi (atau di foreground bila platform tidak punya worker).
+Future<void> importLinks(BuildContext context, List<String> urls) async {
+  if (urls.isEmpty) return;
+  final container = ProviderScope.containerOf(context);
+  final store = UrlImportQueueStore(container.read(appDatabaseProvider));
+  for (final url in urls) {
+    await store.insertEntry(
+      id: createImportId(),
+      sourceUrl: url,
+      sourceType: detectUrlSourceType(url),
+      autoRmbg: false,
+    );
+  }
+  await _startProcessing(container, requiresNetwork: true);
+  if (context.mounted) {
+    _notify(context, '${urls.length} tautan masuk antrean, progres di notifikasi');
+  }
+}
+
+/// Memilih banyak berkas gambar dari penyimpanan (pilih semua isi folder
+/// lewat pemilih berkas sistem) lalu memasukkannya ke antrean impor.
+Future<void> importFiles(BuildContext context) async {
+  final picked = await FilePicker.platform.pickFiles(
+    type: FileType.image,
+    allowMultiple: true,
+  );
+  final paths = picked?.paths.whereType<String>().toList() ?? const <String>[];
+  if (paths.isEmpty || !context.mounted) return;
+
+  final container = ProviderScope.containerOf(context);
+  final repository = BulkImportRepository(
+    store: ImportQueueStore(container.read(appDatabaseProvider)),
+    fileSystemManager: await FileSystemManager.initialize(),
+  );
+  await repository.enqueueFiles(
+    inputPaths: paths,
+    sourceType: SourceType.manualFile,
+  );
+  await _startProcessing(container, requiresNetwork: false);
+  if (context.mounted) {
+    _notify(context, '${paths.length} gambar masuk antrean, progres di notifikasi');
+  }
+}
+
+Future<void> _startProcessing(
+  ProviderContainer container, {
+  required bool requiresNetwork,
+}) async {
+  final scheduled = await const ImportScheduler().schedule(
+    requiresNetwork: requiresNetwork,
+  );
+  if (scheduled) return;
+  await container
+      .read(foregroundImportRunnerProvider)
+      .processAllPending(
+        onStickerAdded: () => container.invalidate(stickerListProvider),
+      );
+}
+
+void _notify(BuildContext context, String message) {
+  ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(message)));
+}
