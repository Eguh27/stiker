@@ -0,0 +1,103 @@
+package com.example.sticker_studio.notification
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import com.example.sticker_studio.MainActivity
+
+/** Notifikasi impor: progres (foreground work) dan hasil akhir. */
+object ImportNotifications {
+    const val PROGRESS_ID = 4101
+    private const val RESULT_ID = 4102
+    private const val CHANNEL_PROGRESS = "import_progress"
+    private const val CHANNEL_RESULT = "import_result"
+
+    fun progress(context: Context, text: String, cancelIntent: PendingIntent?): Notification {
+        ensureChannels(context)
+        val builder = NotificationCompat.Builder(context, CHANNEL_PROGRESS)
+            .setSmallIcon(android.R.drawable.stat_sys_download)
+            .setContentTitle("Mengimpor stiker")
+            .setContentText(text)
+            .setOngoing(true)
+            .setOnlyAlertOnce(true)
+            .setProgress(0, 0, true)
+            .setPriority(NotificationCompat.PRIORITY_LOW)
+        cancelIntent?.let {
+            builder.addAction(android.R.drawable.ic_menu_close_clear_cancel, "Batal", it)
+        }
+        return builder.build()
+    }
+
+    fun updateProgress(context: Context, text: String, cancelIntent: PendingIntent?) {
+        notifySafely(context, PROGRESS_ID, progress(context, text, cancelIntent))
+    }
+
+    fun result(context: Context, added: Int, failed: Int) {
+        if (added == 0 && failed == 0) return
+        ensureChannels(context)
+        val title = when {
+            failed == 0 -> "$added stiker ditambahkan"
+            added > 0 -> "$added stiker ditambahkan, $failed gagal"
+            else -> "Impor gagal ($failed)"
+        }
+        val text = if (added > 0) {
+            "Ketuk untuk mengedit atau membuat pack"
+        } else {
+            "Ketuk untuk melihat penyebabnya di antrean"
+        }
+        val notification = NotificationCompat.Builder(context, CHANNEL_RESULT)
+            .setSmallIcon(
+                if (added > 0) android.R.drawable.stat_sys_download_done
+                else android.R.drawable.stat_notify_error,
+            )
+            .setContentTitle(title)
+            .setContentText(text)
+            .setAutoCancel(true)
+            .setContentIntent(openAppIntent(context))
+            .build()
+        notifySafely(context, RESULT_ID, notification)
+    }
+
+    fun cancelProgress(context: Context) {
+        NotificationManagerCompat.from(context).cancel(PROGRESS_ID)
+    }
+
+    private fun openAppIntent(context: Context): PendingIntent {
+        val intent = Intent(context, MainActivity::class.java).apply {
+            flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
+        }
+        return PendingIntent.getActivity(
+            context,
+            0,
+            intent,
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+        )
+    }
+
+    private fun notifySafely(context: Context, id: Int, notification: Notification) {
+        val manager = NotificationManagerCompat.from(context)
+        if (!manager.areNotificationsEnabled()) return
+        try {
+            manager.notify(id, notification)
+        } catch (_: SecurityException) {
+            // Izin POST_NOTIFICATIONS belum diberikan: abaikan, impor tetap jalan.
+        }
+    }
+
+    private fun ensureChannels(context: Context) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        val manager = context.getSystemService(NotificationManager::class.java)
+        manager.createNotificationChannel(
+            NotificationChannel(CHANNEL_PROGRESS, "Proses impor stiker", NotificationManager.IMPORTANCE_LOW),
+        )
+        manager.createNotificationChannel(
+            NotificationChannel(CHANNEL_RESULT, "Hasil impor stiker", NotificationManager.IMPORTANCE_DEFAULT),
+        )
+    }
+}
