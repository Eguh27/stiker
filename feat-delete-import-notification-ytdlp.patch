+import 'package:flutter/foundation.dart';
+import 'package:sticker_studio/features/data/app_database.dart';
+import 'package:sticker_studio/features/data/file_system_manager.dart';
+import 'package:sticker_studio/features/data/registry_engine.dart';
+
+import 'import_queue_store.dart';
+import 'import_queue_watcher.dart';
+import 'import_summary.dart';
+import 'imported_sticker_store.dart';
+import 'pack_assigning_processor.dart';
+import 'source_pack_assigner.dart';
+import 'sticker_import_processor.dart';
+import 'url_import_queue_store.dart';
+import 'url_import_runner.dart';
+import 'ytdlp_media_resolver.dart';
+
+typedef ImportProgressCallback = void Function(String text);
+
+/// Satu-satunya pipeline impor, dipakai foreground runner dan worker latar
+/// belakang: unduh URL -> encode WebP -> simpan stiker -> masuk pack sumber.
+class ImportPipeline {
+  ImportPipeline({
+    required this.database,
+    required this.fileSystemManager,
+    this.fallbackResolver = resolveImageWithYtDlp,
+  });
+
+  final AppDatabase database;
+  final FileSystemManager fileSystemManager;
+  final Future<String?> Function(String url)? fallbackResolver;
+
+  Future<ImportSummary> run({
+    ImportProgressCallback? onProgress,
+    VoidCallback? onStickerAdded,
+  }) async {
+    final startedAt = DateTime.now();
+    var added = 0;
+
+    onProgress?.call('Mengunduh gambar...');
+    await UrlImportRunner(
+      store: UrlImportQueueStore(database),
+      fileSystemManager: fileSystemManager,
+      extractorsManifestPath: fileSystemManager
+          .registryFile(RegistryEngine.extractorsManifestFileName)
+          .path,
+      fallbackResolver: fallbackResolver,
+    ).processPending();
+
+    onProgress?.call('Memproses stiker...');
+    final processor = PackAssigningProcessor(
+      inner: StickerImportProcessor(
+        stickerStore: ImportedStickerStore(database),
+        fileSystemManager: fileSystemManager,
+      ),
+      assigner: SourcePackAssigner(database),
+      fileSystemManager: fileSystemManager,
+      onStickerAdded: () {
+        added++;
+        onProgress?.call('$added stiker siap');
+        onStickerAdded?.call();
+      },
+    );
+    await ImportQueueWatcher(
+      store: ImportQueueStore(database),
+      processor: processor,
+      staleAfter: const Duration(minutes: 2),
+    ).processPending();
+
+    return ImportSummary(
+      added: added,
+      failed: await countFailedSince(database, startedAt),
+    );
+  }
+}
