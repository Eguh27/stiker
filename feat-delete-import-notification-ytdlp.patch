+import 'package:flutter_test/flutter_test.dart';
+import 'package:sticker_studio/features/data/database/database_enums.dart';
+import 'package:sticker_studio/features/data/import/import_url_parser.dart';
+
+void main() {
+  test('mengambil banyak tautan unik dan membuang tanda baca di ujung', () {
+    const text = '''
+Lihat ini https://pin.it/abc123.
+https://example.com/a.png, dan https://pin.it/abc123
+bukan tautan: example.com
+''';
+    expect(parseImportUrls(text), [
+      'https://pin.it/abc123',
+      'https://example.com/a.png',
+    ]);
+  });
+
+  test('mengabaikan teks tanpa tautan', () {
+    expect(parseImportUrls('halo dunia'), isEmpty);
+  });
+
+  test('mendeteksi jenis sumber', () {
+    expect(detectUrlSourceType('https://www.pinterest.com/pin/1/'), SourceType.pinterest);
+    expect(detectUrlSourceType('https://pin.it/xyz'), SourceType.pinterest);
+    expect(detectUrlSourceType('https://x.com/a/b.JPG'), SourceType.directImageLink);
+    expect(detectUrlSourceType('https://x.com/user/status/1'), SourceType.genericUrl);
+  });
+}
