@@ -0,0 +1,76 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../packs/presentation/pack_providers.dart';
+import '../../queue/presentation/queue_providers.dart';
+import 'sticker_providers.dart';
+
+/// Hapus stiker lalu tawarkan "Urungkan" lewat snackbar. File fisik baru
+/// dibuang setelah snackbar tertutup tanpa urungkan.
+Future<void> deleteStickerWithUndo(
+  BuildContext context,
+  String id, {
+  String message = 'Stiker dihapus',
+  VoidCallback? onUndone,
+}) async {
+  final container = ProviderScope.containerOf(context);
+  final deleter = container.read(stickerDeleterProvider);
+  final deleted = await deleter.delete(id);
+  if (deleted == null) return;
+  _refresh(container);
+  if (!context.mounted) {
+    await deleter.purgeFiles(deleted);
+    return;
+  }
+
+  final messenger = ScaffoldMessenger.of(context)..clearSnackBars();
+  final reason = await messenger
+      .showSnackBar(
+        SnackBar(
+          content: Text(message),
+          action: SnackBarAction(
+            label: 'Urungkan',
+            onPressed: () async {
+              await deleter.restore(deleted);
+              _refresh(container);
+              onUndone?.call();
+            },
+          ),
+        ),
+      )
+      .closed;
+  if (reason != SnackBarClosedReason.action) {
+    await deleter.purgeFiles(deleted);
+  }
+}
+
+/// Dialog konfirmasi (dipakai di grid library, tempat tidak ada swipe).
+Future<void> confirmDeleteSticker(BuildContext context, String id) async {
+  final confirmed = await showDialog<bool>(
+    context: context,
+    builder: (dialogContext) => AlertDialog(
+      title: const Text('Hapus stiker?'),
+      content: const Text('Stiker juga dikeluarkan dari semua pack.'),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(dialogContext).pop(false),
+          child: const Text('Batal'),
+        ),
+        TextButton(
+          onPressed: () => Navigator.of(dialogContext).pop(true),
+          child: const Text('Hapus'),
+        ),
+      ],
+    ),
+  );
+  if (confirmed == true && context.mounted) {
+    await deleteStickerWithUndo(context, id);
+  }
+}
+
+void _refresh(ProviderContainer container) {
+  container
+    ..invalidate(stickerListProvider)
+    ..invalidate(packListProvider)
+    ..invalidate(queueStreamProvider);
+}
