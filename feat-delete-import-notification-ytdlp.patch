+ */
+object YtDlpImageResolver {
+    private val imageExtensions = setOf("jpg", "jpeg", "png", "webp")
+
+    @Volatile
+    private var initialized = false
+
+    @Synchronized
+    private fun ensureInitialized(context: Context) {
+        if (initialized) return
+        YoutubeDL.getInstance().init(context.applicationContext)
+        initialized = true
+    }
+
+    fun resolveImageUrl(context: Context, pageUrl: String): String {
+        ensureInitialized(context)
+        val request = YoutubeDLRequest(pageUrl).apply {
+            addOption("-J")
+            addOption("--no-playlist")
+            addOption("--no-warnings")
+            addOption("--socket-timeout", "20")
+        }
+        val output = YoutubeDL.getInstance().execute(request).out
+        val info = JSONObject(output)
+        return pickImageUrl(info)
+            ?: throw IllegalStateException("Tidak ada gambar yang bisa diambil dari tautan ini")
+    }
+
+    private fun pickImageUrl(info: JSONObject): String? {
+        info.optJSONArray("entries")?.let { entries ->
+            for (index in 0 until entries.length()) {
+                val entry = entries.optJSONObject(index) ?: continue
+                pickImageUrl(entry)?.let { return it }
+            }
+            return null
+        }
+        return directImage(info) ?: bestFormatImage(info) ?: bestThumbnail(info)
+    }
+
+    private fun directImage(info: JSONObject): String? {
+        val url = info.optString("url")
+        val isImage = info.optString("ext").lowercase() in imageExtensions
+        return if (url.isNotEmpty() && isImage) url else null
+    }
+
+    private fun bestFormatImage(info: JSONObject): String? {
+        val formats = info.optJSONArray("formats") ?: return null
+        return largestBy(formats) { it.optString("ext").lowercase() in imageExtensions }
+    }
+
+    private fun bestThumbnail(info: JSONObject): String? {
+        val thumbnails = info.optJSONArray("thumbnails")
+        val fromList = thumbnails?.let { largestBy(it) { true } }
+        return fromList ?: info.optString("thumbnail").takeIf { it.startsWith("http") }
+    }
+
+    private fun largestBy(items: JSONArray, accept: (JSONObject) -> Boolean): String? {
+        var bestUrl: String? = null
+        var bestArea = -1L
+        for (index in 0 until items.length()) {
+            val item = items.optJSONObject(index) ?: continue
+            val url = item.optString("url")
+            if (!url.startsWith("http") || !accept(item)) continue
+            val area = item.optLong("width") * item.optLong("height")
+            if (area >= bestArea) {
+                bestArea = area
+                bestUrl = url
+            }
+        }
+        return bestUrl
+    }
+}
