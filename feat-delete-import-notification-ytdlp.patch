new file mode 100644
index 0000000..b4a40f1
--- /dev/null
+++ b/lib/features/data/sticker/sticker_deleter.dart
@@ -0,0 +1,83 @@
+import 'dart:io';
+
+import '../app_database.dart';
+
+/// Salinan baris yang dihapus, dipakai untuk urungkan dan pembersihan file.
+class DeletedSticker {
+  const DeletedSticker({this.sticker, this.queueEntry, this.packLinks = const []});
+
+  final Sticker? sticker;
+  final ImportQueueEntry? queueEntry;
+  final List<PackSticker> packLinks;
+}
+
+/// Hapus stiker (dan entri antreannya) dengan dukungan urungkan:
+/// baris DB dihapus segera, file baru dibuang setelah urungkan kedaluwarsa.
+class StickerDeleter {
+  StickerDeleter(this._database);
+
+  final AppDatabase _database;
+
+  Future<DeletedSticker?> delete(String id) {
+    return _database.transaction(() async {
+      final sticker = await (_database.select(
+        _database.stickers,
+      )..where((t) => t.id.equals(id))).getSingleOrNull();
+      final queueEntry = await (_database.select(
+        _database.importQueue,
+      )..where((t) => t.id.equals(id))).getSingleOrNull();
+      if (sticker == null && queueEntry == null) return null;
+
+      final links = await (_database.select(
+        _database.packStickers,
+      )..where((t) => t.stickerId.equals(id))).get();
+      await (_database.delete(
+        _database.packStickers,
+      )..where((t) => t.stickerId.equals(id))).go();
+      await (_database.delete(
+        _database.stickers,
+      )..where((t) => t.id.equals(id))).go();
+      await (_database.delete(
+        _database.importQueue,
+      )..where((t) => t.id.equals(id))).go();
+      return DeletedSticker(
+        sticker: sticker,
+        queueEntry: queueEntry,
+        packLinks: links,
+      );
+    });
+  }
+
+  Future<void> restore(DeletedSticker deleted) {
+    return _database.transaction(() async {
+      final sticker = deleted.sticker;
+      if (sticker != null) {
+        await _database.into(_database.stickers).insert(sticker);
+      }
+      final entry = deleted.queueEntry;
+      if (entry != null) {
+        await _database.into(_database.importQueue).insert(entry);
+      }
+      for (final link in deleted.packLinks) {
+        await _database.into(_database.packStickers).insertOnConflictUpdate(link);
+      }
+    });
+  }
+
+  Future<void> purgeFiles(DeletedSticker deleted) async {
+    final paths = <String?>{
+      deleted.sticker?.filePath,
+      deleted.sticker?.thumbPath,
+      deleted.queueEntry?.localInputPath,
+    };
+    for (final path in paths) {
+      if (path == null) continue;
+      try {
+        final file = File(path);
+        if (await file.exists()) await file.delete();
+      } on FileSystemException {
+        // File yang sudah tidak ada atau terkunci tidak boleh menggagalkan hapus.
+      }
+    }
+  }
+}
