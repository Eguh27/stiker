diff --git a/test/data/sticker/sticker_deleter_test.dart b/test/data/sticker/sticker_deleter_test.dart
new file mode 100644
index 0000000..63b2538
--- /dev/null
+++ b/test/data/sticker/sticker_deleter_test.dart
@@ -0,0 +1,92 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:sticker_studio/features/data/app_database.dart';
+import 'package:sticker_studio/features/data/database/database_enums.dart';
+import 'package:sticker_studio/features/data/sticker/sticker_deleter.dart';
+
+import '../support/test_database.dart';
+
+void main() {
+  late AppDatabase database;
+  late Directory tempDir;
+  late File stickerFile;
+  late StickerDeleter deleter;
+
+  setUp(() async {
+    database = createTestDatabase();
+    tempDir = Directory.systemTemp.createTempSync('sticker_deleter_');
+    stickerFile = File('${tempDir.path}/stk-1.webp')..writeAsBytesSync([1, 2]);
+    deleter = StickerDeleter(database);
+
+    await database.into(database.stickers).insert(
+      StickersCompanion.insert(
+        id: 'stk-1',
+        filePath: stickerFile.path,
+        thumbPath: stickerFile.path,
+        width: 512,
+        height: 512,
+        sizeKb: 10,
+        sha256: 'hash-1',
+        sourceType: SourceType.manualFile,
+        createdAt: testTimestamp,
+      ),
+    );
+    await database.into(database.packs).insert(
+      PacksCompanion.insert(
+        id: 'pack-1',
+        name: 'Pack',
+        author: 'Eguh',
+        trayIconPath: stickerFile.path,
+        version: '1',
+        isSynced: false,
+        createdAt: testTimestamp,
+        updatedAt: testTimestamp,
+      ),
+    );
+    await database.into(database.packStickers).insert(
+      PackStickersCompanion.insert(
+        packId: 'pack-1',
+        stickerId: 'stk-1',
+        position: 0,
+      ),
+    );
+  });
+
+  tearDown(() async {
+    await database.close();
+    tempDir.deleteSync(recursive: true);
+  });
+
+  test('delete menghapus stiker dan tautannya dari pack', () async {
+    final deleted = await deleter.delete('stk-1');
+
+    expect(deleted?.sticker?.id, 'stk-1');
+    expect(deleted?.packLinks, hasLength(1));
+    expect(await database.select(database.stickers).get(), isEmpty);
+    expect(await database.select(database.packStickers).get(), isEmpty);
+    expect(stickerFile.existsSync(), isTrue, reason: 'file ditahan untuk urungkan');
+  });
+
+  test('restore mengembalikan stiker dan posisinya di pack', () async {
+    final deleted = await deleter.delete('stk-1');
+
+    await deleter.restore(deleted!);
+
+    expect(await database.select(database.stickers).get(), hasLength(1));
+    final links = await database.select(database.packStickers).get();
+    expect(links.single.packId, 'pack-1');
+  });
+
+  test('purgeFiles membuang file stiker', () async {
+    final deleted = await deleter.delete('stk-1');
+
+    await deleter.purgeFiles(deleted!);
+
+    expect(stickerFile.existsSync(), isFalse);
+  });
+
+  test('delete id yang tidak ada mengembalikan null', () async {
+    expect(await deleter.delete('tidak-ada'), isNull);
+  });
+}
