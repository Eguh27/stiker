+import 'package:sticker_studio/features/data/database/database_enums.dart';
+
+final RegExp _urlPattern = RegExp(r'https?://[^\s<>"]+', caseSensitive: false);
+final RegExp _pinterestHost = RegExp(
+  r'(^|\.)(pinterest\.[a-z]{2,4}(\.[a-z]{2})?|pin\.it)$',
+);
+const List<String> _imageExtensions = ['.jpg', '.jpeg', '.png', '.webp'];
+
+/// Mengambil semua tautan http(s) unik dari teks bebas (satu per baris, atau
+/// satu teks hasil salin yang berisi beberapa tautan).
+List<String> parseImportUrls(String text) {
+  final urls = <String>{};
+  for (final match in _urlPattern.allMatches(text)) {
+    final url = match.group(0)!.replaceAll(RegExp(r'[.,;)\]]+$'), '');
+    if (Uri.tryParse(url)?.host.isNotEmpty ?? false) urls.add(url);
+  }
+  return urls.toList();
+}
+
+SourceType detectUrlSourceType(String url) {
+  final uri = Uri.tryParse(url);
+  if (_pinterestHost.hasMatch(uri?.host.toLowerCase() ?? '')) {
+    return SourceType.pinterest;
+  }
+  final path = uri?.path.toLowerCase() ?? '';
+  return _imageExtensions.any(path.endsWith)
+      ? SourceType.directImageLink
+      : SourceType.genericUrl;
+}
