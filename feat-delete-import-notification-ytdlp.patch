+import 'package:drift/drift.dart';
+import 'package:sticker_studio/features/data/app_database.dart';
+import 'package:sticker_studio/features/data/database/database_enums.dart';
+
+/// Ringkasan satu putaran impor untuk notifikasi hasil.
+class ImportSummary {
+  const ImportSummary({required this.added, required this.failed});
+
+  final int added;
+  final int failed;
+}
+
+/// Jumlah entri yang gagal sejak [since] (presisi detik di SQLite).
+Future<int> countFailedSince(AppDatabase database, DateTime since) async {
+  final threshold = since.subtract(const Duration(seconds: 1));
+  final rows =
+      await (database.select(database.importQueue)..where(
+            (row) =>
+                row.status.equalsValue(ImportStatus.failed) &
+                row.updatedAt.isBiggerOrEqualValue(threshold),
+          ))
+          .get();
+  return rows.length;
+}
