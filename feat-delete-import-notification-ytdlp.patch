+import 'package:flutter/material.dart';
+
+import '../../../core/theme/app_colors.dart';
+import '../../../core/theme/app_spacing.dart';
+import '../domain/queue_item.dart';
+
+/// Geser ke kiri untuk menghapus (seperti hapus email). Hanya item selesai
+/// atau gagal yang bisa dihapus; item yang sedang diproses tidak bisa digeser.
+class QueueSwipeItem extends StatelessWidget {
+  const QueueSwipeItem({
+    super.key,
+    required this.item,
+    required this.onDelete,
+    required this.child,
+  });
+
+  final QueueItem item;
+  final VoidCallback onDelete;
+  final Widget child;
+
+  bool get _deletable =>
+      item.status == QueueStatus.done || item.status == QueueStatus.failed;
+
+  @override
+  Widget build(BuildContext context) {
+    if (!_deletable) return child;
+    final AppColors colors = context.colors;
+    return Dismissible(
+      key: ValueKey<String>('queue-${item.id}'),
+      direction: DismissDirection.endToStart,
+      onDismissed: (_) => onDelete(),
+      background: Container(
+        margin: const EdgeInsets.only(bottom: AppSpacing.s3),
+        padding: const EdgeInsets.only(right: AppSpacing.s6),
+        alignment: Alignment.centerRight,
+        decoration: BoxDecoration(
+          color: colors.danger,
+          borderRadius: AppRadius.card,
+        ),
+        child: const Icon(Icons.delete_outline, color: Colors.white),
+      ),
+      child: child,
+    );
+  }
+}
